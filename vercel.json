{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/sigov-tic/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sigov-api.ashymeadow-7686a936.brazilsouth.azurecontainerapps.io/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
